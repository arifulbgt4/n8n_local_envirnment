# Copy this file to .env before starting the stack.
# Never commit your real .env file.

# IMPORTANT FOR EXISTING n8n DATA:
# If you already have an n8n_data volume with saved credentials, do not set a
# new encryption key here. Reuse the exact old key if you previously configured
# one. For a fresh install, you may uncomment this and use a long random secret.
# N8N_ENCRYPTION_KEY=replace_with_a_long_random_secret

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# Local HTTP access only; do not use this setting for a public deployment.
N8N_SECURE_COOKIE=false

# PostgreSQL database used by n8n workflow nodes for customers, conversations,
# duplicate-message protection, orders, and other application data.
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=n8n_app
POSTGRES_PORT=5432
